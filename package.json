{
  "name": "theyspy",
  "version": "1.3.2",
  "private": true,
  "description": "Self-hosted defender against ad-delivered spyware: Pi-hole hunting, network fleet, CVE and zero-day matching.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --watch server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "vitest run",
    "lint": "eslint server scripts eslint.config.mjs",
    "check:types": "tsc -p tsconfig.server.json",
    "check:looks": "node scripts/check-looks.mjs",
    "check:boxpilot": "node scripts/check-boxpilot-manifest.mjs",
    "check:release": "node scripts/release-check.mjs",
    "check": "npm run build && npm run check:types && npm run test && npm run lint && npm run check:looks && npm run check:boxpilot && npm run check:release"
  },
  "dependencies": {
    "express": "5.2.1",
    "undici": "8.12.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/oswald": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@testing-library/react": "16.3.3",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "yaml": "^2.9.1"
  }
}
