# Copy to .env for `docker compose up`. Every value is optional.
# TS_ADMIN_PASSWORD=     # empty: one is generated on first start and printed once to the log
# TS_SESSION_SECRET=     # empty: generated and kept in the database; changing it signs everyone out
# TS_PORT=8797
# TS_LOOK=auto           # auto | ops | light | pihole | evidence | paper | glass
# TS_BRAND_NAME=TheySpy
# TS_BRAND_TAGLINE=
# TS_ACCENT=             # e.g. #39c6ff; empty uses the look's own
# TS_COOKIE_SECURE=false # true when served over HTTPS
