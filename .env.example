# Copy to .env for `docker compose up`. Every value is optional.
# TS_ADMIN_PASSWORD=     # empty: one is generated on first start and printed once to the log
# TS_SESSION_SECRET=     # empty: generated and kept in the database; changing it signs everyone out
# TS_PORT=8797
# TS_LOOK=auto           # auto | ops | light | pihole | evidence | paper | glass
# TS_BRAND_NAME=TheySpy
# TS_BRAND_TAGLINE=
# TS_ACCENT=             # e.g. #39c6ff; empty uses the look's own
# TS_COOKIE_SECURE=false # true when served over HTTPS
# TS_PIHOLE_URL=        # e.g. http://192.168.1.5:8084 (Pi-hole 6); or set it on the Pi-hole Sentinel screen
# TS_PIHOLE_PASSWORD=   # a Pi-hole app password
# TS_PIHOLE_DB=         # read-only pihole-FTL.db instead of the API
# TS_PIHOLE_WRITE=      # false forbids changing Pi-hole; unset lets the screen decide
# TS_BLOCKLISTS_AUTO=true # update blocklists every 6 h, look for new ones daily
# TS_IOC_AUTOCHECK=true  # daily check for newer indicators (offered for review, never auto-applied)
